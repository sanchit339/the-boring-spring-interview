---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  categories,
  getTotalQuestionCount,
  getTotalFollowUpCount,
} from "../data/questions";

const totalQ = getTotalQuestionCount();
const totalFU = getTotalFollowUpCount();
---

<DocsLayout
  title="Home"
  description="Java Spring Boot interview questions for ~2 years experience — organized Mintlify-style with followups."
>
  <div class="hero">
    <p class="eyebrow">Interview prep · 2 years experience</p>
    <h1 class="display-md">Java Spring Boot<br />Interview Questions</h1>
    <p class="subhead hero-lead">
      {totalQ} core questions across {categories.length} topics, plus {totalFU}{" "}
      interviewer followups — organized like Mintlify docs, styled with Linear’s
      dark canvas.
    </p>
    <div class="hero-actions">
      <a href="/core-java" class="btn btn-primary">Start with Core Java</a>
      <a href="/spring-boot" class="btn btn-secondary">Jump to Spring Boot</a>
      <a href="/discussions" class="btn btn-discussions">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 4a1 1 0 011-1h8a1 1 0 011 1v5a1 1 0 01-1 1H8.5L7 12l-1.5-2H3a1 1 0 01-1-1V4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
        Discussions
      </a>
    </div>
  </div>

  <div class="stats">
    <div class="stat card">
      <span class="stat-value">{totalQ}</span>
      <span class="stat-label caption">Questions</span>
    </div>
    <div class="stat card">
      <span class="stat-value">{totalFU}</span>
      <span class="stat-label caption">Follow-ups</span>
    </div>
    <div class="stat card">
      <span class="stat-value">{categories.length}</span>
      <span class="stat-label caption">Topics</span>
    </div>
  </div>

  <section class="section">
    <div class="section-head">
      <h2 class="display-sm">Browse by topic</h2>
      <p class="body-sm section-desc">
        Same organization as the source list — expand followups on any question
        when you want to probe deeper.
      </p>
    </div>

    <div class="topic-grid">
      {
        categories.map((cat) => (
          <a href={`/${cat.id}`} class="topic-card card">
            <div class="topic-top">
              <span class="topic-icon" aria-hidden="true">
                {cat.icon}
              </span>
              <span class="badge">
                {cat.questions.length} Q ·{" "}
                {cat.questions.reduce((n, q) => n + q.followUps.length, 0)} FU
              </span>
            </div>
            <h3 class="headline topic-title">{cat.title}</h3>
            <p class="body-sm topic-desc">{cat.description}</p>
            <span class="topic-cta caption">
              Open topic
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 6h7M6.5 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Discussions section -->
  <section class="section disc-section">
    <div class="section-head">
      <h2 class="display-sm">Discussions</h2>
      <p class="body-sm section-desc">
        Deep-dive explanations of Spring Boot concepts from real questions —
        read through full discussions with code examples and analogies.
      </p>
    </div>
    <a href="/discussions" class="disc-cta-card card">
      <div class="disc-cta-left">
        <span class="disc-cta-icon">💬</span>
        <div class="disc-cta-text">
          <span class="disc-cta-title">Spring Constructor Dependency Injection</span>
          <span class="disc-cta-desc body-sm">
            Why is a constructor with arguments created when services are annotated with @Service?
            Understand constructor injection vs field injection.
          </span>
        </div>
      </div>
      <span class="disc-cta-arrow">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
    <a href="/discussions" class="disc-view-all caption">
      View all discussions
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2.5 6h7M6.5 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  <section class="section how">
    <div class="card how-card">
      <p class="eyebrow">How to use</p>
      <h2 class="headline">Interview like a pro</h2>
      <ol class="how-list">
        <li>
          <strong>Ask the main question</strong> — let the candidate answer fully
          before interrupting.
        </li>
        <li>
          <strong>Open followups</strong> — each card has 2–3 depth probes for
          gaps, edge cases, and real-world trade-offs.
        </li>
        <li>
          <strong>Search or jump topics</strong> — use ⌘K / Ctrl+K or the sidebar
          to navigate like Mintlify docs.
        </li>
      </ol>
    </div>
  </section>
</DocsLayout>

<style>
  .hero {
    margin-bottom: var(--space-xxl);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-md);
  }

  .hero h1 {
    margin-bottom: var(--space-lg);
  }

  .hero-lead {
    max-width: 540px;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-section);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-lg);
  }

  .stat:hover {
    background: var(--color-surface-1);
  }

  .stat-value {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .stat-label {
    color: var(--color-ink-subtle);
  }

  .section {
    margin-bottom: var(--space-section);
  }

  .section-head {
    margin-bottom: var(--space-xl);
  }

  .section-head h2 {
    margin-bottom: var(--space-sm);
  }

  .section-desc {
    color: var(--color-ink-subtle);
    max-width: 480px;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition: background 0.15s ease, border-color 0.15s ease,
      transform 0.15s ease;
    text-decoration: none;
  }

  .topic-card:hover {
    transform: translateY(-1px);
  }

  .topic-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .topic-icon {
    font-size: 20px;
    line-height: 1;
  }

  .topic-title {
    font-size: 18px;
    letter-spacing: -0.3px;
  }

  .topic-desc {
    color: var(--color-ink-subtle);
    flex: 1;
  }

  .topic-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary-hover);
    margin-top: var(--space-xs);
    font-weight: 500;
  }

  .how-card {
    padding: var(--space-xl);
  }

  .how-card .eyebrow {
    margin-bottom: var(--space-sm);
  }

  .how-card .headline {
    margin-bottom: var(--space-lg);
  }

  .how-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    counter-reset: how;
  }

  .how-list li {
    position: relative;
    padding-left: 36px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-ink-muted);
    counter-increment: how;
  }

  .how-list li::before {
    content: counter(how);
    position: absolute;
    left: 0;
    top: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-primary-hover);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent);
    border-radius: var(--radius-sm);
  }

  .how-list strong {
    color: var(--color-ink);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Discussions button in hero */
  .btn-discussions {
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    color: var(--color-primary-hover);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    gap: 8px;
  }
  .btn-discussions:hover {
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
  }

  /* Discussions section */
  .disc-section {
    margin-bottom: var(--space-section);
  }

  .disc-cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg);
    text-decoration: none;
    margin-bottom: var(--space-md);
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    position: relative;
    overflow: hidden;
  }

  .disc-cta-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-primary);
    border-radius: var(--radius-xs);
    opacity: 0.8;
  }

  .disc-cta-card:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .disc-cta-left {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    flex: 1;
    min-width: 0;
  }

  .disc-cta-icon {
    font-size: 24px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .disc-cta-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .disc-cta-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .disc-cta-desc {
    color: var(--color-ink-subtle);
    line-height: 1.5;
  }

  .disc-cta-arrow {
    color: var(--color-primary-hover);
    opacity: 0.6;
    flex-shrink: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .disc-cta-card:hover .disc-cta-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .disc-view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary-hover);
    font-weight: 500;
    transition: gap 0.15s ease;
  }

  .disc-view-all:hover {
    gap: 10px;
  }
</style>

