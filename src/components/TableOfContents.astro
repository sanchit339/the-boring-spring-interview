---
interface TocItem {
  id: string;
  label: string;
  number: number;
}

interface Props {
  items: TocItem[];
  title?: string;
}

const { items, title = "On this page" } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="toc" aria-label="Table of contents">
      <p class="toc-title">{title}</p>
      <nav class="toc-nav">
        {items.map((item) => (
          <a href={`#q-${item.id}`} class="toc-link" data-toc={item.id}>
            <span class="toc-num">{item.number}</span>
            <span class="toc-label">{item.label}</span>
          </a>
        ))}
      </nav>
    </aside>
  )
}

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    width: var(--toc-width);
    flex-shrink: 0;
    max-height: calc(100vh - var(--header-height) - 48px);
    overflow-y: auto;
    padding-left: var(--space-lg);
  }

  .toc-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
    margin-bottom: var(--space-sm);
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--color-hairline);
  }

  .toc-link {
    display: flex;
    gap: 8px;
    padding: 5px 0 5px 12px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-ink-tertiary);
    border-left: 1px solid transparent;
    margin-left: -1px;
    transition: color 0.12s ease, border-color 0.12s ease;
  }

  .toc-link:hover {
    color: var(--color-ink-muted);
  }

  .toc-link :global(.active),
  .toc-link.active {
    color: var(--color-ink);
    border-left-color: var(--color-primary);
  }

  .toc-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-tertiary);
    flex-shrink: 0;
    min-width: 18px;
  }

  .toc-label {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .toc {
      display: none;
    }
  }
</style>
