---
import { categories } from "../data/questions";

interface Props {
  currentCategory?: string;
}

const { currentCategory } = Astro.props;
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">
    <div class="sidebar-section">
      <p class="sidebar-label">Getting started</p>
      <nav class="sidebar-nav">
        <a
          href="/"
          class:list={["sidebar-link", { active: !currentCategory }]}
        >
          <span class="link-icon">⌂</span>
          Overview
        </a>
      </nav>
    </div>

    <div class="sidebar-section">
      <p class="sidebar-label">Topics</p>
      <nav class="sidebar-nav">
        {
          categories.map((cat) => (
            <a
              href={`/${cat.id}`}
              class:list={[
                "sidebar-link",
                { active: currentCategory === cat.id },
              ]}
              data-category={cat.id}
            >
              <span class="link-icon" aria-hidden="true">
                {cat.icon}
              </span>
              <span class="link-text">{cat.title}</span>
              <span class="link-count">{cat.questions.length}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="sidebar-footer">
      <p class="caption">
        Linear UI · Mintlify layout
      </p>
    </div>
  </div>
</aside>

<div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>

<style>
  .sidebar {
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    width: var(--sidebar-width);
    flex-shrink: 0;
    border-right: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
  }

  .sidebar-section {
    margin-bottom: var(--space-xl);
  }

  .sidebar-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
    padding: 0 10px;
    margin-bottom: var(--space-xs);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-subtle);
    transition: background 0.12s ease, color 0.12s ease;
  }

  .sidebar-link:hover {
    background: var(--color-surface-1);
    color: var(--color-ink);
  }

  .sidebar-link.active {
    background: var(--color-surface-2);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }

  .sidebar-link.active .link-count {
    color: var(--color-primary-hover);
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .link-icon {
    width: 18px;
    text-align: center;
    font-size: 13px;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .link-text {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-count {
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-tertiary);
    background: var(--color-surface-1);
    border-radius: var(--radius-pill);
    padding: 1px 7px;
    flex-shrink: 0;
  }

  .sidebar-footer {
    margin-top: auto;
    padding: var(--space-md) 10px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .sidebar-backdrop {
    display: none;
  }

  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      left: 0;
      top: var(--header-height);
      z-index: 40;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: 8px 0 32px rgba(0, 0, 0, 0.4);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: var(--color-overlay);
      z-index: 35;
    }

    .sidebar-backdrop[hidden] {
      display: none;
    }
  }
</style>
