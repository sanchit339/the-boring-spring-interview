---
import type { Question } from "../data/types";
import { codeToHtml } from "shiki";

interface Props {
  question: Question;
  categoryId: string;
}

const { question } = Astro.props;
const hasFollowUps = question.followUps.length > 0;
const hasAnswer = !!(question.answer || question.explanation);

/** Render inline `code` spans from markdown-ish backticks */
function renderText(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
}

/**
 * Render content with Shiki-powered VS Code syntax highlighting.
 * Supports fenced code blocks, **bold**, inline `code`, paragraphs.
 */
async function renderContent(text: string): Promise<string> {
  // Step 1: Extract and replace fenced code blocks with shiki HTML
  const codeBlockPlaceholders: string[] = [];

  // Match ```lang\n...\n``` blocks
  const codeBlockRegex = /```(\w*)\n([\s\S]*?)```/g;
  const withPlaceholders = text.replace(codeBlockRegex, (_, lang, code) => {
    codeBlockPlaceholders.push({ lang: lang || "text", code: code.trimEnd() } as any);
    return `\x00CODEBLOCK_${codeBlockPlaceholders.length - 1}\x00`;
  });

  // Step 2: Escape HTML in non-code text
  let out = withPlaceholders
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  // Step 3: Restore shiki-highlighted code blocks
  for (let i = 0; i < codeBlockPlaceholders.length; i++) {
    const { lang, code } = codeBlockPlaceholders[i] as any;
    const supportedLangs = ["java", "xml", "yaml", "properties", "bash", "sh", "json", "sql", "groovy", "kotlin"];
    const resolvedLang = supportedLangs.includes(lang) ? lang : "text";

    const highlighted = await codeToHtml(code, {
      lang: resolvedLang,
      theme: "dark-plus",
    });

    // Wrap shiki output with our code-block container class
    const wrapped = highlighted.replace(
      /^<pre /,
      '<pre class="shiki-block" '
    );

    out = out.replace(`\x00CODEBLOCK_${i}\x00`, wrapped);
  }

  // Step 4: **bold**
  out = out.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");

  // Step 5: inline `code` — only in non-pre sections
  const parts = out.split(/(<pre[\s\S]*?<\/pre>)/g);
  out = parts
    .map((part) => {
      if (part.startsWith("<pre")) return part;
      return part.replace(/`([^`\n]+)`/g, "<code>$1</code>");
    })
    .join("");

  // Step 6: Paragraph breaks — skip pre blocks
  const segments = out.split(/(<pre[\s\S]*?<\/pre>)/g);
  out = segments
    .map((seg) => {
      if (seg.startsWith("<pre")) return seg;
      return seg
        .split(/\n\n+/)
        .map((p) => p.trim())
        .filter(Boolean)
        .map((p) => `<p>${p.replace(/\n/g, "<br>")}</p>`)
        .join("");
    })
    .join("");

  return out;
}

// Pre-render content at build time
const renderedAnswer = question.answer ? await renderContent(question.answer) : "";
const renderedExplanation = question.explanation ? await renderContent(question.explanation) : "";

// Pre-render follow-up answers (template callbacks can't be async)
const renderedFollowUpAnswers = await Promise.all(
  question.followUps.map((fu) => (fu.answer ? renderContent(fu.answer) : ""))
);
---

<article class="question" id={`q-${question.id}`}>
  <div class="question-header">
    <span class="question-num mono">{String(question.id).padStart(3, "0")}</span>
    <h2 class="question-title" set:html={renderText(question.text)} />
  </div>

  {
    hasAnswer && (
      <div class="answer-section">
        <button
          type="button"
          class="answer-toggle"
          aria-expanded="false"
          data-answer-toggle
        >
          <span class="toggle-icon answer-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
              <path d="M7 5v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="7" cy="9.5" r="0.6" fill="currentColor"/>
            </svg>
          </span>
          <span class="toggle-label">See Answer &amp; Explanation</span>
          <span class="chevron" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path
                d="M4.5 2.5L8 6L4.5 9.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </button>

        <div class="answer-panel" hidden data-answer-panel>
          {renderedAnswer && (
            <div class="answer-block">
              <span class="block-label">Expected Answer</span>
              <div class="answer-text" set:html={renderedAnswer} />
            </div>
          )}
          {renderedExplanation && (
            <div class="explanation-block">
              <span class="block-label">Practical Explanation</span>
              <div class="explanation-text" set:html={renderedExplanation} />
            </div>
          )}
        </div>
      </div>
    )
  }

  {
    hasFollowUps && (
      <div class="followups">
        <button
          type="button"
          class="followups-toggle"
          aria-expanded="false"
          data-followup-toggle
        >
          <span class="toggle-icon" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path
                d="M4.5 2.5L8 6L4.5 9.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="toggle-label">
            {question.followUps.length} follow-up
            {question.followUps.length === 1 ? "" : "s"}
          </span>
          <span class="badge badge-primary">Ask next</span>
        </button>

        <div class="followups-panel" hidden data-followup-panel>
          <ol class="followups-list">
            {question.followUps.map((fu, i) => (
              <li class="followup-item">
                <span class="followup-marker" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="followup-body">
                  <span
                    class="followup-text"
                    set:html={renderText(fu.text)}
                  />
                  {fu.answer && (
                    <div
                      class="followup-answer prose"
                      set:html={renderedFollowUpAnswers[i]}
                    />
                  )}
                </div>
              </li>
            ))}
          </ol>
          <p class="followup-hint caption">
            Use these to go deeper after the candidate answers the main
            question.
          </p>
        </div>
      </div>
    )
  }
</article>

<style>
  .question {
    scroll-margin-top: calc(var(--header-height) + 24px);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .question:last-child {
    border-bottom: none;
  }

  .question-header {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .question-num {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-primary-hover);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    margin-top: 2px;
    letter-spacing: 0;
  }

  .question-title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.1px;
    color: var(--color-ink);
  }

  .question-title :global(code) {
    font-size: 0.9em;
  }

  /* ── Answer Section ── */
  .answer-section {
    margin-top: var(--space-md);
    margin-left: calc(12px + 8px + 16px + 16px);
  }

  .answer-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    color: var(--color-primary-hover);
    font-size: 13px;
    font-weight: 500;
    transition: background 0.12s ease, border-color 0.12s ease;
    cursor: pointer;
  }

  .answer-toggle:hover {
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .answer-toggle[aria-expanded="true"] {
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .answer-toggle[aria-expanded="true"] .chevron {
    transform: rotate(90deg);
  }

  .answer-icon {
    display: flex;
    color: var(--color-primary-hover);
  }

  .chevron {
    display: flex;
    transition: transform 0.15s ease;
    color: var(--color-primary-hover);
    opacity: 0.7;
  }

  .answer-panel {
    margin-top: var(--space-sm);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-primary) 4%, var(--color-surface-1));
    overflow: hidden;
  }

  .block-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-hover);
    margin-bottom: var(--space-sm);
    opacity: 0.8;
  }

  .answer-block {
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .answer-text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .answer-text :global(p) {
    margin: 0 0 var(--space-sm) 0;
  }

  .answer-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .answer-text :global(code) {
    font-size: 0.88em;
  }

  .answer-text :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .explanation-block {
    padding: var(--space-md) var(--space-lg);
  }

  .explanation-text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .explanation-text :global(p) {
    margin: 0 0 var(--space-sm) 0;
  }

  .explanation-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .explanation-text :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .explanation-text :global(code) {
    font-size: 0.88em;
  }

  /* ── Shiki VS Code code blocks ── */
  .explanation-text :global(pre.shiki-block),
  .answer-text :global(pre.shiki-block) {
    margin: var(--space-sm) 0;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid #333;
    overflow-x: auto;
    /* Shiki inlines background — we respect it */
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    position: relative;
  }

  /* Shiki outputs <code> inside <pre> — strip global code styles */
  .explanation-text :global(pre.shiki-block code),
  .answer-text :global(pre.shiki-block code) {
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-family: inherit;
  }

  /* Shiki token spans — remove any interference */
  .explanation-text :global(pre.shiki-block .line),
  .answer-text :global(pre.shiki-block .line),
  .followup-answer :global(pre.shiki-block .line) {
    display: block;
  }

  /* Collapse blank lines within code blocks (Shiki renders them as empty .line spans) */
  .explanation-text :global(pre.shiki-block .line:empty),
  .answer-text :global(pre.shiki-block .line:empty),
  .followup-answer :global(pre.shiki-block .line:empty) {
    height: 0;
    min-height: 0 !important;
    margin: 0;
    padding: 0;
    line-height: 0;
    overflow: hidden;
  }

  /* ── Follow-ups ── */
  .followups {
    margin-top: var(--space-md);
    margin-left: calc(12px + 8px + 16px + 16px); /* align under title */
  }

  .followups-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink-muted);
    font-size: 13px;
    font-weight: 500;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
    cursor: pointer;
  }

  .followups-toggle:hover {
    background: var(--color-surface-2);
    border-color: var(--color-hairline-strong);
    color: var(--color-ink);
  }

  .followups-toggle[aria-expanded="true"] {
    background: var(--color-surface-2);
    border-color: var(--color-hairline-strong);
    color: var(--color-ink);
  }

  .followups-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }

  .toggle-icon {
    display: flex;
    transition: transform 0.15s ease;
    color: var(--color-ink-subtle);
  }

  .toggle-label {
    color: inherit;
  }

  .followups-panel {
    margin-top: var(--space-sm);
    padding: var(--space-md);
    background: var(--color-surface-1);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.03);
  }

  .followups-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .followup-item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .followup-marker {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-ink-subtle);
    background: var(--color-surface-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xs);
    margin-top: 1px;
  }

  .followup-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  .followup-text :global(code) {
    font-size: 0.9em;
  }

  .followup-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    min-width: 0;
  }

  .followup-answer {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-ink-muted);
    padding-top: var(--space-xs);
  }

  .followup-answer :global(code) {
    font-size: 0.9em;
  }

  .followup-answer :global(pre) {
    margin: var(--space-xs) 0;
  }

  .followup-hint {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-hairline);
    color: var(--color-ink-tertiary);
  }

  @media (max-width: 640px) {
    .followups,
    .answer-section {
      margin-left: 0;
    }
    .question-header {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>

<script>
  // Event delegation for all toggles and global expand/collapse
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    // Follow-up accordion toggle
    const followupBtn = target.closest("[data-followup-toggle]") as HTMLButtonElement | null;
    if (followupBtn) {
      const expanded = followupBtn.getAttribute("aria-expanded") === "true";
      const panel = followupBtn.nextElementSibling as HTMLElement | null;
      followupBtn.setAttribute("aria-expanded", String(!expanded));
      if (panel) panel.hidden = expanded;
      return;
    }

    // Answer & explanation accordion toggle
    const answerBtn = target.closest("[data-answer-toggle]") as HTMLButtonElement | null;
    if (answerBtn) {
      const expanded = answerBtn.getAttribute("aria-expanded") === "true";
      const panel = answerBtn.nextElementSibling as HTMLElement | null;
      answerBtn.setAttribute("aria-expanded", String(!expanded));
      if (panel) panel.hidden = expanded;
      return;
    }

    // Expand all follow-ups
    if (target.closest("#expand-all-followups")) {
      document.querySelectorAll("[data-followup-toggle]").forEach((btn) => {
        btn.setAttribute("aria-expanded", "true");
        const panel = btn.nextElementSibling as HTMLElement | null;
        if (panel) panel.hidden = false;
      });
      return;
    }

    // Collapse all follow-ups
    if (target.closest("#collapse-all-followups")) {
      document.querySelectorAll("[data-followup-toggle]").forEach((btn) => {
        btn.setAttribute("aria-expanded", "false");
        const panel = btn.nextElementSibling as HTMLElement | null;
        if (panel) panel.hidden = true;
      });
      return;
    }
  });
</script>
